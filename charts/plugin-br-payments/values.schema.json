              "PLUGIN_AUTH_CLIENT_SECRET",
              "POSTGRES_PASSWORD",
              "POSTGRES_REPLICA_PASSWORD",
              "PROVIDER_CLIENT_ID",
              "PROVIDER_CLIENT_SECRET"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true
    },
    "otel-collector-lerian": {
      "type": "object",
      "additionalProperties": true
    },
    "aws": {
      "type": "object",
      "additionalProperties": true
    },
    "plugin-br-payments": {
      "type": "object",
      "additionalProperties": true
    },
    "datastores": {
      "type": "object",
      "description": "Datastore masks for this chart only (override global.datastores).",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {},
            "port": {},
            "user": {},
            "name": {},
            "ssl": {},
            "replicaHost": {}
          }
        }
      }
    }
