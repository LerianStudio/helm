              "MULTI_TENANT_CACHE_TTL_SEC",
              "MULTI_TENANT_CB_THRESHOLD",
              "MULTI_TENANT_CB_TIMEOUT_SEC",
              "MULTI_TENANT_CIRCUIT_BREAKER_THRESHOLD",
              "MULTI_TENANT_CIRCUIT_BREAKER_TIMEOUT_SEC",
              "MULTI_TENANT_CLIENT_TIMEOUT_SEC",
              "MULTI_TENANT_CREDENTIAL_SOURCE",
              "MULTI_TENANT_DISCOVERY_INTERVAL_SEC",
              "MULTI_TENANT_ENABLED",
              "MULTI_TENANT_IDLE_TIMEOUT_SEC",
              "MULTI_TENANT_MANAGER_URL",
              "MULTI_TENANT_MAX_TENANT_POOLS",
              "MULTI_TENANT_POSTGRES_MODULE",
              "MULTI_TENANT_SERVICE_NAME",
              "MULTI_TENANT_TIMEOUT",
