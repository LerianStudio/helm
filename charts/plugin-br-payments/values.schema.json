              "BTG_MTLS_OUTBOUND_CERT_FILE",
              "BTG_MTLS_OUTBOUND_ENABLED",
              "BTG_MTLS_OUTBOUND_KEY_FILE",
              "BTG_TOKEN_REFRESH_INTERVAL",
              "BTG_WEBHOOK_CERTIFICATE_URL",
              "CIRCUIT_BREAKER_ENABLED",
              "DB_METRICS_INTERVAL_SEC",
              "DEPLOYMENT_MODE",
              "ENABLE_TELEMETRY",
              "ENV_NAME",
              "EXAMPLE_STATUS_PROVIDER_MODE",
              "HTTP_BODY_LIMIT_BYTES",
              "HTTP_READ_BUFFER_SIZE",
              "IDEMPOTENCY_RECORD_TTL_HOURS",
              "INFRA_CONNECT_TIMEOUT_SEC",
              "INTERNAL_WORKER_URL",
              "LOG_LEVEL",
              "M2M_CRM_TARGET_SERVICE",
              "MIDAZ_ALLOW_INSECURE_HTTP",
              "MIDAZ_AUTH_ENABLED",
              "MIDAZ_CRM_URL",
              "MIDAZ_DEFAULT_LEDGER_ID",
              "MIDAZ_DEFAULT_ORG_ID",
              "MIDAZ_LEDGER_URL",
              "MIDAZ_ONBOARDING_URL",
              "MIDAZ_TRANSACTION_URL",
              "MIGRATION_LOCK_TIMEOUT_MS",
              "MIGRATION_TIMEOUT_SEC",
              "MULTI_TENANCY_ENABLED",
              "MULTI_TENANT_ALLOW_INSECURE_HTTP",
