{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer"
    },
    "revisionHistoryLimit": {
      "type": "integer"
    },
    "readinessProbe": {
      "type": "object",
      "additionalProperties": true
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "additionalProperties": true
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "datastores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {},
              "port": {},
              "user": {},
              "uri": {},
              "params": {}
            }
          },
          "description": "Env-wide SHARED datastore masks (set once per environment). Consumed by lerian-common.datastore.value."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {},
            "host": {}
          },
          "description": "Env-wide Access Manager (plugin-auth) gate/host. Consumed by lerian-common.globalValue (block \"auth\")."
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {}
          },
          "description": "Env-wide telemetry gate. Consumed by lerian-common.globalValue (block \"observability\")."
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "spread": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Master switch for the spread preset"
                },
                "hostname": {
                  "type": "string",
                  "default": "ScheduleAnyway",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
                },
                "zone": {
                  "type": "string",
                  "default": "ScheduleAnyway",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
                },
                "maxSkew": {
                  "type": "integer",
                  "default": 1,
                  "minimum": 1,
                  "description": "Max allowed pod-count difference between topology domains"
                }
              },
              "description": "topologySpreadConstraints preset (lerian-common.topologySpreadConstraints) applied to every Deployment"
            }
          },
          "description": "Env-wide pod scheduling. `spread` is the topologySpreadConstraints preset applied to every Deployment."
        },
        "externalMongoDefinitions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "pdb": {
      "type": "object",
      "additionalProperties": true
    },
    "deploymentStrategy": {
      "type": "object",
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "additionalProperties": true
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Master switch for the spread preset"
        },
        "hostname": {
          "type": "string",
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule",
            ""
          ],
          "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
        },
        "zone": {
          "type": "string",
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule",
            ""
          ],
          "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1,
          "description": "Max allowed pod-count difference between topology domains"
        }
      },
      "description": "Per-component override of global.scheduling.spread (field by field)"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Raw Kubernetes topologySpreadConstraints; non-empty replaces the spread preset entirely"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true
    },
    "otel": {
      "type": "object",
      "additionalProperties": true
    },
    "configmap": {
      "type": "object",
      "properties": {
        "FLOWKER_BASE_PATH": { "type": ["string", "null"] },
        "LENDER_BASE_PATH": { "type": ["string", "null"] },
        "MATCHER_BASE_PATH": { "type": ["string", "null"] },
        "MFA_ENABLED": { "type": ["string", "boolean", "null"] },
        "MIDAZ_V2_BASE_PATH": { "type": ["string", "null"] },
        "PLUGIN_AUTH_PUBLIC_BASE_PATH": { "type": ["string", "null"] },
        "TRACER_BASE_PATH": { "type": ["string", "null"] },
        "TRUSTED_PROXIES": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "extraEnvVars": {
      "type": "object",
      "properties": {
        "TRUSTED_PROXIES": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true
    },
    "useExistingSecret": {
      "type": "boolean"
    },
    "existingSecretName": {
      "type": "string"
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
