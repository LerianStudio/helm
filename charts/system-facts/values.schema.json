{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "system-facts": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "migrations": {
      "type": "object",
      "additionalProperties": true
    },
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        },
        "products": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["midaz", "plugin-br-pix-jd"]
          }
        },
        "systemFacts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "url": {
              "type": "string"
            },
            "authUrl": {
              "type": "string"
            },
            "allowInsecureHttp": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": true
    },
    "lerian-common-helm": {
      "type": "object",
      "additionalProperties": true
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true
    },
    "valkey": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
