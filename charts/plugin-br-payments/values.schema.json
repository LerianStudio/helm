{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {}
          }
        },
        "datastores": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {},
                "port": {},
                "user": {},
                "name": {},
                "ssl": {},
                "replicaHost": {}
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {},
            "host": {}
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {},
            "otlpEndpoint": {},
            "deploymentEnvironment": {}
          }
        },
        "multiTenant": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {},
            "url": {}
          }
        },
        "cloud": {
          "type": "string"
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object",
          "description": "Per-key overrides of the template-owned ConfigMap. Keys outside this list are not rendered by the chart; renamed/retired keys are accepted here only so the render can name their replacement.",
