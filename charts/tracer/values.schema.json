{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cloud": {
          "type": "string",
          "enum": ["aws", "gcp", "azure"],
          "description": "Managed-cloud topology preset consumed by lerian-common.cloud.block (sets TLS/SSL mode defaults for the datastore masks; endpoints still come from global.datastores)."
        },
        "datastores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {},
              "port": {},
              "user": {},
              "ssl": {}
            }
          },
          "description": "Env-wide SHARED datastore mask (set once per environment). Consumed by lerian-common.datastore.value."
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {}
          },
          "description": "Env-wide environment name. Consumed by lerian-common.globalValue (block \"env\")."
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {},
            "otlpEndpoint": {}
          },
          "description": "Env-wide telemetry gate + endpoint. Consumed by lerian-common.globalValue (block \"observability\")."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {},
            "host": {}
          },
          "description": "Env-wide auth (plugin-access-manager). Consumed by lerian-common.globalValue (block \"auth\")."
        }
      }
    },
    "tracer": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
