{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "profile": {
      "type": "string",
      "description": "own = our environment (collects node infra); client = client cluster (does not). Required, no default. Validation lives in the chart, NOT as a schema enum: the enum fires first and reports \"value must be one of 'own','client'\", hiding the guard that actually explains the difference and what each profile collects — and the common case is a first install with no profile at all."
    },
    "origin": {
      "type": "object",
      "additionalProperties": true
    },
    "destination": {
      "type": "object",
      "additionalProperties": true
    },
    "collection": {
      "type": "object",
      "additionalProperties": true
    },
    "roles": {
      "type": "object",
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "additionalProperties": true
    },
    "singleton": {
      "type": "object",
      "additionalProperties": true
    },
    "receiver": {
      "type": "object",
      "additionalProperties": true
    },
    "inspection": {
      "type": "object",
      "additionalProperties": true
    },
    "logging": {
      "type": "object",
      "additionalProperties": true
    },
    "fleetManagement": {
      "type": "object",
      "additionalProperties": true
    },
    "kube-state-metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "node-exporter": {
      "type": "object",
      "description": "Subchart do node-exporter. `enabled: false` por padrao — ligar so em ambiente nosso, e junto com collection.nodeInfrastructure. Segue o padrao do guarda-chuva da Grafana: o exportador e um componente, o agente so raspa.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "destination",
    "origin",
    "profile"
  ]
}
