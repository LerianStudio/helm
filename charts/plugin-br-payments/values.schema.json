          }
        },
        "secrets": {
          "type": "object",
          "description": "Per-key Secret values, each rendered only when set.",
          "propertyNames": {
            "enum": [
              "BTG_CLIENT_ID",
              "BTG_CLIENT_SECRET",
              "BTG_WEBHOOK_HMAC_SECRET",
              "BTG_WEBHOOK_SECRET",
