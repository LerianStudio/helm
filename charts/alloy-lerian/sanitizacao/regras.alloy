// Regras de sanitizacao de dado regulado — ARCABOUCO DE VERIFICACAO
//
// IMPORTANTE: este arquivo e o alvo de teste, nao a configuracao de producao.
// Diferenca deliberada: error_mode = "propagate" aqui, "ignore" em producao.
// E justamente porque producao ignora erro que este arcabouco existe.
//
// Notacao de retrovinculacao: $1 (verificado empiricamente — ver
// subtasks/T-003/EVIDENCIA-retrovinculacao.md). NUNCA $$1.
//
// Forma de invocacao: replace_pattern e funcao EDITORA — declaracao propria,
// nunca aninhada em set(). Aninhar falha na carga.

otelcol.receiver.otlp "entrada" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    logs = [otelcol.processor.transform.sanitizacao.input]
  }
}

otelcol.processor.transform "sanitizacao" {
  error_mode = "propagate"

  log_statements {
    context = "log"
    statements = [
      // --- TELEFONE ---
      // E.164 com pais e DDD: +5511987654321 -> +5511********
      `replace_pattern(body, "(\\+[0-9]{2}[0-9]{2})[0-9]{8,9}", "$1********")`,

      // Forma nacional com separadores: (11) 98765-4321 -> (11) *****-****
      `replace_pattern(body, "(\\([0-9]{2}\\) )[0-9]{4,5}-[0-9]{4}", "$1*****-****")`,

      // --- CONTA E AGENCIA ---
      // Por NOME DE CAMPO, nao por forma: a forma varia de 1 (`branch:1`) a 20
      // (`account:12880000007785418277`) digitos, indistinguivel de `gateway:6`.
      `replace_pattern(body, "(?i)((?:conta |account(?:_?number)?(?:origin|destination|source|target|from|to)?[=:]))([0-9]{4,})", "$1********")`,
      `replace_pattern(body, "(?i)((?:ag[eê]ncia |(?:agency|branch)(?:_?number)?(?:origin|destination|source|target|from|to)?[=:]))([0-9]+)", "$1****")`,

      // --- NOME DE PESSOA ---
      // Campos conhecidos: customerName, senderName, recipientName,
      // receiverName, clientName, holderName.
      //
      // UMA regra, e ela mascara TODOS os termos apos o primeiro. Antes havia
      // duas (3+ termos, e exatamente 2) e AMBAS vazavam — pior que nao mascarar,
      // porque a saida aparenta estar protegida:
      //
      //   Ana Silva              -> "Ana ********** Silva"   nome inteiro legivel
      //   Ana Beatriz Costa Lima -> "Ana ********** Lima"    sobrenome preservado
      //
      // O sobrenome e o termo MAIS identificador; preserva-lo anula a regra. O
      // primeiro nome fica para legibilidade em diagnostico, o resto vai.
      //
      // Depende de convencao de caixa: termos de nome comecam em maiuscula e o
      // texto seguinte no log e minusculo, o que delimita o fim do valor SEM
      // retrovisor — que o motor desta versao nao suporta (falha na CARGA com
      // "unsupported Perl syntax: (?!").
      //
      // Verificado: 1 termo nao e mascarado, 2/3/4 termos sao mascarados por
      // inteiro, e um campo `chave=valor` seguinte nao e consumido.
      `replace_pattern(body, "((?:customer|sender|recipient|receiver|client|holder)(?:Name|_name)\\W{1,4})(\\p{Lu}[\\p{L}]*)(?: (?:(?i:d[aeio]s?|e|y|del|la) )?\\p{Lu}[\\p{L}]*)+", "$1$2 **********")`,

      // --- ENDERECO DE CORREIO ELETRONICO ---
      // Preserva os 2 primeiros caracteres da parte local e o dominio INTEIRO.
      // Dominio preservado de proposito: e util para diagnostico (identifica o
      // provedor ou o cliente corporativo) e nao identifica a pessoa.
      // Nao depende de prefixo de campo — casa qualquer email no corpo.
      `replace_pattern(body, "([A-Za-z0-9]{1,2})[A-Za-z0-9._%+-]*(@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})", "$1****$2")`,

      // --- CHAVE PIX ---
      // Por rotulo: a chave pode ser CPF, CNPJ ou UUID, que ficam em claro sem rotulo.
      // \x22 e a aspa do JSON; a literal esconderia a regra do extrator do diff.
      `replace_pattern(body, "(?i)((?:chave_?pix|pix_?key)\\x22?[=:] ?\\x22?)[^\\s\\x22,;}]+", "$1**********")`,

      // --- ENDERECO POSTAL ---
      // Mascaramento INTEGRAL: nao ha parte do endereco que seja segura preservar.
      // Ao contrario do email (dominio) ou telefone (DDD), qualquer fragmento de
      // endereco reduz drasticamente o espaco de busca da pessoa.
      // Delimita o fim do valor pela convencao de caixa: o valor comeca em
      // maiuscula e o texto seguinte do log e minusculo (mesma premissa da
      // regra de nome — ver README, secao de premissas).
      `replace_pattern(body, "((?:address|street|logradouro|endereco)[=:] ?)[\\p{Lu}0-9][^=]*?( [a-z_]+[=:]|$)", "$1**********$2")`,

      // --- CREDENCIAL DE AUTENTICACAO ---
      // Difere em natureza de todas as regras acima: aquelas protegem dado que
      // IDENTIFICA alguem, esta protege valor que CONCEDE ACESSO. Credencial
      // vazada nao e incidente de privacidade, e sessao autenticada na mao de
      // terceiro — e permanece exploravel ate expirar.
      //
      // Preserva o NOME DO ESQUEMA e nada mais. "Bearer" vs "Basic" e o que
      // torna a falha de autenticacao diagnosticavel; nenhum fragmento da
      // credencial tem valor de diagnostico, e preservar prefixo de JWT
      // revelaria o algoritmo de assinatura.
      //
      // Esquema com caixa exata e chave so antes de `=`/`:`: prosa como
      // "invalid token signature" ou "basic validation failed" fica legivel.
      `replace_pattern(body, "((?:Bearer|Basic|Digest) |(?i:token|apikey|api_key)[=:] ?)[A-Za-z0-9._~+/=-]{8,}", "$1**********")`,

      // Forma de atribuicao, onde o esquema nao antecede o valor.
      // A CHAVE e preservada porque saber QUAL credencial apareceu e o que torna
      // o vazamento acionavel — nao se rotaciona o que nao se nomeia.
      `replace_pattern(body, "(?i)((?:password|passwd|senha|secret|client_secret|access_token|refresh_token|private_key)[=:] ?)[^\\s,;}]+", "$1**********")`,
    ]
  }

  output {
    logs = [otelcol.exporter.debug.saida.input]
  }
}

otelcol.exporter.debug "saida" {
  verbosity = "detailed"
}
