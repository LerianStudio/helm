            "enum": [
              "ACCESS_CONTROL_ALLOW_CREDENTIALS",
              "ACCESS_CONTROL_ALLOW_HEADERS",
              "ACCESS_CONTROL_ALLOW_METHODS",
              "ACCESS_CONTROL_ALLOW_ORIGIN",
              "ACCESS_CONTROL_EXPOSE_HEADERS",
              "ACCOUNTING_ROUTES_CACHE_TTL_SEC",
              "ACCOUNTING_ROUTES_ENABLED",
              "ACCOUNTING_ROUTES_FETCH_TIMEOUT_SEC",
              "ACCOUNT_VALIDATION_DISABLED",
              "AGGRESSIVE_RATE_LIMIT_MAX",
              "AGGRESSIVE_RATE_LIMIT_WINDOW_SEC",
              "ALLOW_INSECURE_TLS",
              "AWS_REGION",
              "BTG_API_BASE_URL",
              "BTG_AUTH_URL",
              "BTG_COMMON_BASE_URL",
              "BTG_CREDENTIAL_SYNC_INTERVAL",
              "BTG_HTTP_TIMEOUT",
              "BTG_MTLS_INBOUND_CERT_HEADER",
