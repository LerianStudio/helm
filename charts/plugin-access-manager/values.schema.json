{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "common": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sso": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "type": "string",
              "description": "Scheme + host (plus path prefix) the console is served from. The chart appends the console SSO callback route. Empty omits the key."
            },
            "callbackUrl": {
              "type": "string",
              "description": "Literal full callback URL, replacing composition from baseUrl. Absolute http(s) URL ending in the console SSO callback route. Mutually exclusive with baseUrl."
            },
            "allowCustomCallbackPath": {
              "type": "boolean",
              "description": "Lift the console-route path check on callbackUrl. Only for a deployment that answers SSO on another path."
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        },
        "spread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Master switch for the spread preset"
            },
            "hostname": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
            },
            "zone": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1,
              "description": "Max allowed pod-count difference between topology domains",
              "maximum": 2147483647
            },
            "minDomains": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "description": "Minimum eligible domains for DoNotSchedule constraints (0 = off)"
            },
            "nodeTaintsPolicy": {
              "type": "string",
              "enum": [
                "Honor",
                "Ignore",
                ""
              ],
              "description": "Honor | Ignore | \"\" (omitted = Kubernetes default Ignore)"
            }
          },
          "description": "Per-component override of global.scheduling.spread (field by field)"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Raw Kubernetes topologySpreadConstraints; non-empty replaces the spread preset entirely"
        }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        },
        "spread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Master switch for the spread preset"
            },
            "hostname": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
            },
            "zone": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1,
              "description": "Max allowed pod-count difference between topology domains",
              "maximum": 2147483647
            },
            "minDomains": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "description": "Minimum eligible domains for DoNotSchedule constraints (0 = off)"
            },
            "nodeTaintsPolicy": {
              "type": "string",
              "enum": [
                "Honor",
                "Ignore",
                ""
              ],
              "description": "Honor | Ignore | \"\" (omitted = Kubernetes default Ignore)"
            }
          },
          "description": "Per-component override of global.scheduling.spread (field by field)"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Raw Kubernetes topologySpreadConstraints; non-empty replaces the spread preset entirely"
        }
      },
      "additionalProperties": true
    },
    "caradhras": {
      "type": "object",
      "properties": {
        "configmap": {
          "type": "object"
        },
        "secrets": {
          "type": "object"
        },
        "ui": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "spread": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Master switch for the spread preset"
                },
                "hostname": {
                  "type": "string",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
                },
                "zone": {
                  "type": "string",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
                },
                "maxSkew": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Max allowed pod-count difference between topology domains",
                  "maximum": 2147483647
                },
                "minDomains": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647,
                  "description": "Minimum eligible domains for DoNotSchedule constraints (0 = off)"
                },
                "nodeTaintsPolicy": {
                  "type": "string",
                  "enum": [
                    "Honor",
                    "Ignore",
                    ""
                  ],
                  "description": "Honor | Ignore | \"\" (omitted = Kubernetes default Ignore)"
                }
              },
              "description": "Per-component override of global.scheduling.spread (field by field)"
            },
            "topologySpreadConstraints": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Raw Kubernetes topologySpreadConstraints; non-empty replaces the spread preset entirely"
            }
          }
        },
        "spread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Master switch for the spread preset"
            },
            "hostname": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
            },
            "zone": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule",
                ""
              ],
              "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1,
              "description": "Max allowed pod-count difference between topology domains",
              "maximum": 2147483647
            },
            "minDomains": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "description": "Minimum eligible domains for DoNotSchedule constraints (0 = off)"
            },
            "nodeTaintsPolicy": {
              "type": "string",
              "enum": [
                "Honor",
                "Ignore",
                ""
              ],
              "description": "Honor | Ignore | \"\" (omitted = Kubernetes default Ignore)"
            }
          },
          "description": "Per-component override of global.scheduling.spread (field by field)"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Raw Kubernetes topologySpreadConstraints; non-empty replaces the spread preset entirely"
        }
      },
      "additionalProperties": true
    },
    "auth-database": {
      "type": "object",
      "additionalProperties": true
    },
    "valkey": {
      "type": "object",
      "additionalProperties": true
    },
    "otel-collector-lerian": {
      "type": "object",
      "additionalProperties": true
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cloud": {
          "type": "string",
          "enum": [
            "",
            "aws",
            "gcp",
            "azure"
          ],
          "description": "Managed-cloud topology preset. Empty = bundled in-cluster infra (plaintext)."
        },
        "datastores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {},
              "port": {},
              "user": {},
              "ssl": {},
              "tls": {},
              "caCert": {}
            }
          },
          "description": "Env-wide SHARED datastore masks (set once per environment)."
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {}
          },
          "description": "Env-wide environment name. Consumed by lerian-common.globalValue (block \"env\")."
        },
        "multiTenant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {}
          },
          "description": "Env-wide multi-tenancy gate. Consumed by lerian-common.globalValue (block \"multiTenant\")."
        },
        "serviceDiscovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {},
            "tls": {},
            "tlsSkipVerify": {},
            "workload": {},
            "preferView": {},
            "internalScheme": {},
            "externalPort": {}
          },
          "description": "Env-wide service discovery (Consul) tuning. Consumed by lerian-common.serviceDiscovery.env."
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {}
          },
          "description": "Env-wide telemetry gate. Consumed by lerian-common.globalValue (block \"observability\")."
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {},
            "annotations": {},
            "tls": {},
            "domain": {}
          },
          "description": "Env-wide ingress shared contract (className/annotations/tls/domain). Consumed by lerian-common.ingress; per-component ingress.* always wins."
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "spread": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Master switch for the spread preset"
                },
                "hostname": {
                  "type": "string",
                  "default": "ScheduleAnyway",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across nodes (kubernetes.io/hostname): ScheduleAnyway (soft) | DoNotSchedule (hard) | \"\" (off)"
                },
                "zone": {
                  "type": "string",
                  "default": "",
                  "enum": [
                    "ScheduleAnyway",
                    "DoNotSchedule",
                    ""
                  ],
                  "description": "Spread across zones (topology.kubernetes.io/zone): ScheduleAnyway | DoNotSchedule | \"\" (off)"
                },
                "maxSkew": {
                  "type": "integer",
                  "default": 1,
                  "minimum": 1,
                  "description": "Max allowed pod-count difference between topology domains",
                  "maximum": 2147483647
                },
                "minDomains": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 2147483647,
                  "description": "Minimum eligible domains for DoNotSchedule constraints (0 = off)"
                },
                "nodeTaintsPolicy": {
                  "type": "string",
                  "default": "",
                  "enum": [
                    "Honor",
                    "Ignore",
                    ""
                  ],
                  "description": "Honor | Ignore | \"\" (omitted = Kubernetes default Ignore)"
                }
              },
              "description": "topologySpreadConstraints preset (lerian-common.topologySpreadConstraints) applied to every Deployment"
            }
          },
          "description": "Env-wide pod scheduling. `spread` is the topologySpreadConstraints preset applied to every Deployment."
        }
      }
    }
  }
}
