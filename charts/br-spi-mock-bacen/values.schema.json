{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "br-spi-mock-bacen values",
  "description": "Values contract for the non-production BACEN simulator chart. Hand-maintained: the chart carries security invariants (production block, ClusterIP-only exposure, reserved ENV_NAME) that the generic schema generator does not express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "serviceAccount",
    "podSecurityContext",
    "securityContext",
    "app"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "namespaceOverride": {
      "type": "string",
      "maxLength": 63
    },
    "environment": {
      "description": "Single source of truth for the runtime environment. Production-like values are rejected: this chart deploys a simulator with unauthenticated control endpoints.",
      "type": "string",
      "enum": ["local", "development", "test", "ci"]
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "commonLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "commonAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 63 },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "automountServiceAccountToken": {
          "description": "Must stay false: the mock never calls the Kubernetes API, so the Pod and the ServiceAccount carry no token.",
          "type": "boolean",
          "enum": [false]
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podSecurityContext": {
      "description": "Closed contract: only runAsNonRoot and seccompProfile.type are accepted. The Deployment renders this map verbatim, so any undeclared field (runAsUser: 0, supplementalGroups, sysctls, ...) would reach the Pod and weaken the documented baseline.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "enum": [true] },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault"] }
          }
        }
      }
    },
    "securityContext": {
      "description": "Closed contract: only the fields below are accepted. The Deployment renders this map verbatim, so an undeclared field (procMount, a container-level seccompProfile, capabilities.add, ...) would reach the container. UID/GID are pinned to 65532, the distroless nonroot user in the published image.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsNonRoot",
        "runAsUser",
        "runAsGroup",
        "allowPrivilegeEscalation",
        "readOnlyRootFilesystem",
        "capabilities"
      ],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "enum": [true] },
        "runAsUser": { "type": "integer", "const": 65532 },
        "runAsGroup": { "type": "integer", "const": 65532 },
        "allowPrivilegeEscalation": { "type": "boolean", "enum": [false] },
        "readOnlyRootFilesystem": { "type": "boolean", "enum": [true] },
        "privileged": { "type": "boolean", "enum": [false] },
        "capabilities": {
          "description": "drop only: `add` is rejected outright. Kubernetes applies additions independently of drops, so `add: [NET_RAW]` alongside `drop: [ALL]` would still grant the capability.",
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "description": "Must include ALL: the mock needs no Linux capability.",
              "type": "array",
              "items": { "type": "string" },
              "contains": { "const": "ALL" }
            }
          }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "configmap", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updateStrategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["RollingUpdate", "Recreate"]
            },
            "maxSurge": { "type": ["integer", "string"] },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        },
        "configmap": {
          "description": "Free-form non-secret configuration. ENV_NAME is reserved and always rendered from the top-level environment value.",
          "type": "object",
          "additionalProperties": { "type": "string" },
          "not": { "required": ["ENV_NAME"] }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {
            "type": {
              "description": "ClusterIP only: the mock has no authentication and must not be published outside the cluster.",
              "type": "string",
              "enum": ["ClusterIP"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": {
              "description": "The named container port only. A numeric value could diverge from the Deployment's containerPort and leave the Service forwarding nowhere.",
              "type": "string",
              "enum": ["http"]
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": { "type": ["string", "integer"] }
            },
            "limits": {
              "type": "object",
              "additionalProperties": { "type": ["string", "integer"] }
            }
          }
        },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "affinity": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "path"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
