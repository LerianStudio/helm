            "periodSeconds": {
              "default": 10
            },
            "timeoutSeconds": {
              "default": 3
            },
            "successThreshold": {
              "default": 1
            },
            "failureThreshold": {
              "default": 3
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": true,
          "description": "Node selector for scheduling pods on specific nodes"
        },
        "tolerations": {
          "type": "array",
          "description": "Tolerations for scheduling on tainted nodes"
